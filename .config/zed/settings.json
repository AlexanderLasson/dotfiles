{
  "edit_predictions": {
    "provider": "zed"
  },
  "session": {
    "trust_all_worktrees": true
  },
  "proxy": "",
  "agent_servers": {
    "claude-acp": {
      "default_config_options": {
        "effort": "medium",
        "model": "default",
        "mode": "default"
      },
      "type": "registry"
    }
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "dock": "left",
    "tree_view": true
  },
  "project_panel": {
    "dock": "left",
    "hide_gitignore": false
  },
  "disable_ai": true,
  "buffer_font_family": "JetBrainsMono Nerd Font Mono",
  "ensure_final_newline_on_save": false,
  "cursor_shape": "block",
  "format_on_save": "off",
    "buffer_font_features": {
      "calt": false
    },
  "show_edit_predictions": true,
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "vim_mode": true,
  "vim": {
    "use_system_clipboard":"always",
    "use_smartcase_find": true,
  },
  "relative_line_numbers":"enabled",
  "cursor_blink": false,
  "icon_theme": {
    "mode": "light",
    "light": "Zed (Default)",
    "dark": "Zed (Default)"
  },
  "ui_font_size": 24.0,
  "buffer_font_size": 24,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "VSCode Dark Modern"
  },
  "theme_overrides": { // to remove italics
    "Gruvbox Material Dark Hard": {
      "syntax":{
        "comment": {
          "font_style": "normal"
        },
        "keyword": {
          "font_style":"normal"
        },
        "function":{
          "font_style":"normal"
        },
        "conditional":{
          "font_style":"normal"
        },
        "repeat":{
          "font_style":"normal"
        }
      }
    }

  }
}
